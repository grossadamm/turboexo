 int wiringpi_init_mode = WPI_MODE_UNINITIALISED;
 
+static int getEnvironmentPin(const char *name)
+{
+    const char *text = getenv(name);
+    char *end = NULL;
+    long value;
+
+    if(text == NULL || text[0] == '\0')
+        return -1;
+
+    value = strtol(text, &end, 10);
+    if(end == text || end[0] != '\0' || value < 0 || value > 2147483647L)
+        return -1;
+    return (int)value;
+}
+
+static int getVirtualSysfsPinForBcm(int bcmPin)
+{
+    int virtualBcm = getEnvironmentPin("PI4J_VIRTUAL_BCM");
+    int virtualSysfs = getEnvironmentPin("PI4J_VIRTUAL_SYSFS_GPIO");
+    if(virtualBcm >= 0 && virtualSysfs >= 0 && bcmPin == virtualBcm)
+        return virtualSysfs;
+    return -1;
+}
+
+int isVirtualPin(int pin)
+{
+    int bcmPin = wiringpi_init_mode == WPI_MODE_GPIO ? pin : wpiPinToGpio(pin);
+    return getVirtualSysfsPinForBcm(bcmPin) >= 0;
+}
+
